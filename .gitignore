# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Flutter build artifacts
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.packages
flutter_app/pubspec.lock
flutter_app/coverage/
flutter_app/.fvm/
flutter_app/analysis_options.yaml.bak

# Flutter IDE
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
*.pem
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.code-workspace

# Ignore any file or directory containing 'claude' (case-insensitive)
*[Cc][Ll][Aa][Uu][Dd][Ee]*

# Documentation and tracking files that shouldn't be committed
*_IMPLEMENTATION.md
*_REQUIREMENTS*.md
*_SETUP.md
COMPLETE_*.md
OFFLINE_*.md

# Utility and analysis scripts
run_*.sh
run_*.py
tmp_*.py
write_*.py
push_*.sh

# Task management files
tasks/todo.md

# Firebase and platform credential files
GoogleService-Info.plist
google-services.json
flutter_app/ios/Runner/GoogleService-Info.plist
flutter_app/android/app/google-services.json
*firebase-adminsdk*.json
AuthKey_*.p8
*.p8
*.p12
*.cer

# Local project notes and generated reports
*_REPORT.md
PROJECT_UNDERSTANDING.md
TEST_RESULTS*.md

# Local verification/setup scripts
quick-test.sh
test-*.sh
setup-function-schedule.js
setup-schedule.mjs
verify-schedule-setup.js
